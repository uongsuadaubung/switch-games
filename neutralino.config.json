{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.uongsuadaubung.switchgames",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "build/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false
  },
  "nativeBlockList": [],
  "modes": {
    "window": {
      "title": "Switch Games Manager",
      "width": 1100,
      "height": 750,
      "minWidth": 1000,
      "minHeight": 600,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/icons/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": true,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "switch-games",
    "resourcesPath": "build/",
    "extensionsPath": "/",
    "clientLibrary": "/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}